{
  "name": "lumiverse-desk-companion",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build:backend": "bun build src/backend.ts --outfile dist/backend.js --target bun",
    "build:frontend": "bun build src/frontend.ts --outfile dist/frontend.js --target browser",
    "build:widget": "bun build src/widget.ts --outfile dist/widget.js --target browser --minify",
    "build": "bun run build:backend && bun run build:frontend && bun run build:widget",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "jsdom": "29.0.1",
    "lumiverse-spindle-types": "0.6.37",
    "typescript": "5.6.3"
  }
}
